---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "RunByEmeric - Accompagnement Running à Genève",
  description = "Accompagnement running personnalisé à Genève avec Emeric Pujos. Plans d'entraînement sur mesure, suivi hebdomadaire et sorties accompagnées pour tous les niveaux.",
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://runbyemeric.ch",
);
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- Encodage & viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- SEO de base -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Emeric Pujos" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (partage réseaux sociaux) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content="RunByEmeric" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script
      src="https://kit.fontawesome.com/dd53ab9e05.js"
      crossorigin="anonymous"
      defer></script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
  }

  *,
  *::before,
  *::after {
    box-sizing: inherit;
  }
</style>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "RunByEmeric",
    "description": "Coach running à Genève",
    "url": "https://runbyemeric.ch",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Genève",
      "addressCountry": "CH"
    }
  }
</script>
