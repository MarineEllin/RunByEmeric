---
import logo from "../assets/logo.svg";
---

<footer id="container" class="bkg-dark">
  <div class="d-flex space-evenly">
    <!-- Logo & baseline -->
    <section
      id="links"
      class="d-flex-column align-items-center bkg-light border-radius-1 m2 p2"
      aria-label="RunByEmeric"
    >
      <a href="/" aria-label="RunByEmeric - Retour à l'accueil">
        <img
          src={logo.src}
          width="300"
          height="60"
          alt="RunByEmeric - Accompagnement running Genève"
          loading="lazy"
        />
      </a>
      <p
        style="font-style: normal;"
      >
        <p>Ensemble</p>
        <p>Une foulée à la fois</p>
        <p>Toujours vers l'avant</p>
      </p>
    </section>

    <!-- Navigation -->
    <nav
      id="navigation"
      class="d-flex-column text-color-light m2"
      aria-label="Liens du footer"
    >
      <h2>Navigation</h2>
      <ul class="d-flex-column" style="list-style: none">
        <li><a href="/" class="hover-peps">Accueil</a></li>
        <li><a href="/Apropos" class="hover-peps">A propos</a></li>
        <li>
          <a href="/Tarifs" class="hover-peps">Tarifs accompagnement running</a>
        </li>
        <li><a href="/Contact" class="hover-peps">Contact</a></li>
      </ul>
    </nav>

    <!-- Contact -->
    <section
      id="contact"
      class="d-flex-column align-items-center m1 text-color-light m2"
      aria-label="Coordonnées"
    >
      <h2>Contact</h2>
      <address style="font-style: normal;">
        <p>
          <a
            href="mailto:runbyemeric@gmail.com"
            aria-label="Envoyer un email à
          RunByEmeric"
            class="hover-peps"
          >
            runbyemeric@gmail.com
          </a>
        </p>
        <p>
          <a
            href="tel:+41783335547"
            aria-label="Appeler Emeric Pujos"
            class="hover-peps"
          >
            +41 78 333 55 47
          </a>
        </p>
      </address>
    </section>
  </div>
  <p
  id="droits"
  style="text-align: center; font-size: 12px; padding: 1rem; opacity: 0.5;"
  class="text-color-light"
>
  © {new Date().getFullYear()} RunByEmeric · Accompagnement running Genève · Tous
  droits réservés
</p>
</footer>



<style>
  #navigation,
  #contact {
    height: 100%;
    text-align: center;
  }

  h2 {
    margin-bottom: 2rem;
  }

  #droits {
    text-align: center;
    font-size: 12px; 
    padding: 1rem; 
    opacity: 0.5;"
  }

  /* =========================
       TABLETTE
    ========================= */
  @media screen and (max-width: 1024px) {
    #container > div {
      flex-wrap: wrap;
      gap: 1rem;
      padding: 1.5rem;
      justify-content: center;
    }

    #links {
      width: 100%;
      align-items: center;
      text-align: center;
      margin: 0;
      padding: 1rem;
    }

    #links img {
      width: 220px;
      height: auto;
    }

    #navigation,
    #contact {
      flex: 1;
      min-width: 160px;
      margin: 0;
      font-size: 0.95rem;
    }

    h2 {
      margin-bottom: 1rem;
    }
  }

  /* =========================
       MOBILE
    ========================= */
  @media screen and (max-width: 768px) {
    #container > div {
      flex-direction: column;
      align-items: center;
      padding: 1.5rem 1rem;
      gap: 1rem;
    }

    #links {
      width: calc(100% - 2rem);
      align-items: center;
      text-align: center;
      margin: 0;
      padding: 0.75rem;
    }

    #links img {
      width: 120px;
      height: auto;
    }

    #navigation,
    #contact {
      width: 100%;
      margin: 0;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 0.8rem;
    }

    #contact {
      border-bottom: none;
    }

    h2 {
      margin-bottom: 0.75rem;
      font-size: 1rem;
    }
  }

  /* =========================
       PETITS SMARTPHONES
    ========================= */
  @media screen and (max-width: 480px) {

    @media screen and (max-width: 768px) {
    #container > div {
      flex-direction: column;
      align-items: center;
      padding: 1.5rem 1rem;

    }
    #links {
      padding: 0.5rem;
    }

    #links p {
      font-size: 0.6rem;
    }

    #links img {
      width: 90px;
    }

    #links address p {
      font-size: 0.9rem;
    }

  }
</style>
