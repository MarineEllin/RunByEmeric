---
import LiensContact from "../LiensContact.astro";
import Book from "../Book.astro";
import bg from "../../assets/bkgrun.png";
---

<div
  id="hero-container"
  style={`background-image: url(${bg.src}); background-size: cover; background-repeat: no-repeat; background-position: center top;`}
>
  <main id="hero-content">
    <aside id="hero-liens-contact" aria-label="Liens de contact">
      <LiensContact />
    </aside>

    <section aria-labelledby="hero-title">
      <h3 id="hero-title" class="text-color-dark">
        Accompagnement Running Genève
      </h3>

      <h1 id="hero-name" class="text-color-peps">
        <span class="text-color-dark">Run</span>
        <span>By</span>
        <span class="text-color-dark">Emeric</span>
      </h1>

      <div id="hero-description" class="text-color-dark">
        <p>
          Derrière chaque coureur, il y a un objectif, une histoire, un rythme
          qui lui est propre.
        </p>
        <p>
          Emeric vous accompagne avec l'expérience d'un passionné de terrain,
          pour progresser à votre façon — concrètement, humainement, et toujours
          avec plaisir.
        </p>
        <p>Ensemble, une foulée à la fois, toujours vers l'avant.</p>
      </div>

      <Book />
    </section>
  </main>
</div>

<style>
  /* ===== HERO WRAPPER ===== */
  #hero-container {
    width: 100%;
    height: 60vh;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center top;
  }

  /* ===== MAIN LAYOUT (FIX 40/60) ===== */
  #hero-content {
    display: grid;
    grid-template-columns: 40% 60%;
    gap: 3rem;
    padding: 6rem;
    background-color: rgba(245, 237, 227, 0.75);
    height: 100%;
    align-items: start;
  }

  /* ===== LEFT COLUMN ===== */
  #hero-liens-contact {
    display: flex;
    flex-direction: column;
  }

  /* ===== TYPO ===== */
  #hero-title {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  #hero-name {
    font-size: 54px;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  #hero-description {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  /* ===== RESPONSIVE ===== */
  @media screen and (max-width: 768px) {
    #hero-content {
      grid-template-columns: 1fr;
      padding: 4rem 2rem;
      gap: 2rem;
    }

    #hero-title {
      font-size: 20px;
      margin-bottom: 1rem;
    }

    #hero-name {
      font-size: 36px;
      margin-bottom: 1rem;
    }

    #hero-description {
      font-size: 16px;
    }
  }

  @media screen and (max-width: 480px) {
    #hero-content {
      padding: 2rem 1rem;
    }
  }
</style>
