---
import LiensContact from "../LiensContact.astro";
import Book from "../Book.astro";
import bg from "../../assets/bkgrun.png";
---

<section
  id="hero-container"
  style={`background-image: url(${bg.src}); background-size: cover; background-repeat: no-repeat; background-position: center top;`}
>
  <main id="hero-content" class="d-flex gap2">
    <aside id="hero-liens-contact" aria-label="Liens de contact">
      <LiensContact />
    </aside>

    <section aria-labelledby="hero-title">
      <p class="eyebrow text-color-peps">Accompagnement Running · Genève</p>

      <h1 id="hero-name" class="text-color-peps">
        <span class="text-color-dark">Run</span>
        <span>By</span>
        <span class="text-color-dark">Emeric</span>
      </h1>

      <div id="hero-description" class="text-color-dark">
        <p>
          Derrière chaque coureur, il y a un objectif, une histoire, un rythme
          qui lui est propre.
        </p>
        <p>
          Emeric vous accompagne avec l'expérience d'un passionné de terrain,
          pour progresser à votre façon — concrètement, humainement, et toujours
          avec plaisir.
        </p>
        <p>Ensemble, une foulée à la fois, toujours vers l'avant.</p>
      </div>
      <Book />
    </section>
  </main>

  <style>
    #hero-container {
      background-size: cover;
      background-repeat: no-repeat;
      background-position: center top;
      position: relative;
      width: 100%;
      height: auto;
    }

    #hero-container::before {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(255, 255, 255, 0.8);
      pointer-events: none;
    }

    #hero-content {
      position: relative;
      z-index: 1;
      padding: 6rem;
    }

    #hero-liens-contact {
      height: 100%;
    }

    #hero-title {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 2rem;
    }

    #hero-name {
      font-size: 54px;
      font-weight: 700;
      margin-bottom: 2rem;
    }

    #hero-description {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      font-size: 20px;
      font-weight: 400;
      margin-bottom: 2rem;
    }

    @media screen and (max-width: 768px) {
      #hero-liens-contact {
        margin-right: 2rem;
      }
      #hero-content {
        padding: 4rem 2rem;
      }
      #hero-title {
        font-size: 20px;
        margin-bottom: 1rem;
      }
      #hero-name {
        font-size: 36px;
        margin-bottom: 1rem;
      }
      #hero-description {
        font-size: 15px;
      }
    }

    @media screen and (max-width: 480px) {
      #hero-liens-contact {
        margin-right: 1rem;
      }
      #hero-content {
        padding: 2rem 1rem;
      }
      #hero-description {
        font-size: 14px;
      }
    }
  </style>
</section>
