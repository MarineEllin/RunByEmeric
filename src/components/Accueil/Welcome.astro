---
import LiensContact from "../LiensContact.astro";
import Book from "../Book.astro";
import bg from "../../assets/bkgrun.png";
---

<div id="hero-container" style={`background-image: url(${bg.src});`}>
  <main id="hero-content">
    <aside id="hero-liens-contact">
      <LiensContact />
    </aside>

    <section>
      <h3 id="hero-title">Accompagnement Running Genève</h3>

      <h1 id="hero-name">
        <span>Run</span>
        <span>By</span>
        <span>Emeric</span>
      </h1>

      <div id="hero-description">
        <p>Derrière chaque coureur...</p>
        <p>Emeric vous accompagne...</p>
        <p>Ensemble, une foulée à la fois...</p>
      </div>

      <Book />
    </section>
  </main>
</div>

<style>
  #hero-container {
    width: 100%;
    height: 60vh;
    background-size: cover;
    background-position: center;
  }

  /* 🚨 FORÇAGE TOTAL */
  #hero-content {
    display: flex !important;
    flex-direction: row !important;
    width: 100%;
    height: 100%;
    padding: 6rem;
    gap: 3rem;
    background-color: rgba(245, 237, 227, 0.75);
  }

  /* 40% */
  #hero-liens-contact {
    flex: 0 0 40% !important;
    max-width: 40% !important;
  }

  /* 60% */
  #hero-content > section {
    flex: 0 0 60% !important;
    max-width: 60% !important;
  }

  /* debug visuel */
  #hero-liens-contact {
    outline: 2px solid red;
  }

  #hero-content > section {
    outline: 2px solid blue;
  }

  @media (max-width: 768px) {
    #hero-content {
      flex-direction: column !important;
      padding: 3rem 1.5rem;
    }

    #hero-liens-contact,
    #hero-content > section {
      flex: 1 1 auto !important;
      max-width: 100% !important;
    }
  }
</style>
