---
const { direction = "-column" } = Astro.props;
---

<div id="linksContainer">
  <main id="linksContent">
    <section id="links" class={`d-flex${direction} text-color-dark`}>
      <a
        href="https://www.strava.com/athletes/93065431"
        target="_blank"
        rel="noopener"
      >
        <button class="bubble">
          <i class="fa-brands fa-strava"></i>
        </button>
      </a>

      <a
        href="https://wa.me/41783335547?text=Bonjour%20Emeric%2C%20je%20souhaite%20réserver%20une%20séance"
        target="_blank"
        rel="noopener"
      >
        <button class="bubble">
          <i class="fa-brands fa-whatsapp"></i>
        </button>
      </a>
      <a
        href="https://www.instagram.com/runbyemeric/"
        target="_blank"
        rel="noopener"
      >
        <button class="bubble">
          <i class="fa-brands fa-instagram"></i>
        </button>
      </a>
    </section>
  </main>
</div>

<style>
  #linksContainer,
  #linksContent {
    height: 100%;
  }

  #links {
    height: 100%;
    gap: 3rem;
  }

  i {
    text-align: center;
    font-size: 24px;
    height: 24px;
    width: 24px;
  }

  @media screen and (max-width: 1024px) {
    i {
      font-size: 20px;
      height: 20px;
      width: 20px;
    }
  }

  @media screen and (max-width: 768px) {
    i {
      font-size: 16px;
      height: 16px;
      width: 16px;
    }
  }

  @media screen and (max-width: 480px) {
    i {
      font-size: 12px;
      height: 12px;
      width: 12px;
    }
  }
</style>
