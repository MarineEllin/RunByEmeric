---
import Book from "../Book.astro";

const background = ["bkg-light", "bkg-peps", "bkg-light"];

const tarifs = [
  {
    duration: "1 mois",
    title: "Coup d'envoi",
    text: "Lance-toi avec un programme structuré et un accompagnement concret dès la première semaine.",
    price: "179",
    includes: [
      "Entretien WhatsApp de 30 minutes pour cerner tes objectifs",
      "Programme running personnalisé d'un mois",
      "1 sortie accompagnée d'1h avec debrief complet",
      "1 point WhatsApp par semaine pour suivre ta progression",
    ],
  },
  {
    duration: "2 mois",
    title: "Montée en puissance",
    text: "Progresse avec un suivi qui s'adapte à toi et à tes résultats.",
    price: "259",
    includes: [
      "Entretien WhatsApp de 30 minutes pour cerner tes objectifs",
      "Programme running personnalisé d'un mois + 1 ajustement selon tes retours",
      "2 sortie accompagnée d'1h avec debrief complet",
      "1 point WhatsApp par semaine pour suivre ta progression",
    ],
  },
  {
    duration: "3 mois",
    title: "Full engagement",
    text: "Vise un objectif précis et mets toutes les chances de ton côté sur la durée.",
    price: "329",
    includes: [
      "Entretien WhatsApp de 30 minutes pour cerner tes objectifs",
      "Programme running personnalisé d'un mois + 2 ajustement selon tes retours",
      "3 sortie accompagnée d'1h avec debrief complet",
      "1 point WhatsApp par semaine pour suivre ta progression",
    ],
  },
];
---

<div id="container">
  <main id="content" class="d-flex-column">
    <!-- BLOC 1 : Tarifs-->
    <section
      aria-labelledby="tarifs-title"
      class="d-flex-column align-items-center gap2"
    >
      <h1 id="tarifs-title" class="text-color-peps">Programmes complets</h1>
      <span id="blocs" class="d-flex gap2">
        {
          tarifs.map((item, index) => (
            <article id="article" class="d-flex-column bloc gap2">
              <p
                id="duration"
                class={`px1 border-radius-1 ${background[index]}`}
              >
                {item.duration}
              </p>
              <h2>{item.title}</h2>
              <p id="text">{item.text}</p>
              <section class="d-flex gapx">
                <h2>{item.price}</h2>
                <p>CHF</p>
              </section>
              <hr class="separator" />
              <section>
                {item.includes.map((para) => (
                  <li class="text-justify">{para}</li>
                ))}
              </section>
            </article>
          ))
        }
      </span>
      <Book style="margin-top: auto;" />
    </section>
  </main>
</div>

<style>
  #content {
    padding: 6rem;
  }

  #article {
    width: 420px;
  }

  #duration {
    margin-bottom: 2rem;
    font-size: 12px;
    max-width: fit-content;
  }

  #text {
    height: 80px;
  }

  h2 {
    margin-top: -0.8rem;
  }

  li {
    margin: 0 2rem;
    list-style: circle;
  }

  @media screen and (max-width: 1400px) {
    #blocs {
      display: flex;
      flex-direction: column;
    }

     @media screen and (max-width: 480px) {
    #blocs {
      display: flex;
      flex-direction: column;
    }
     #article {
      width: 330px;
  }
  }
</style>
