---
import Book from "../Book.astro";

const background = ["bkg-light", "bkg-peps", "bkg-light"];

const tarifs = [
  {
    duration: "1 mois",
    title: "Coup d'envoi",
    text: "Lance-toi avec un accompagnement concret dès la première semaine.",
    price: "189",
    // priceoffer: "149",
    includes: [
      "Permier entretien WhatsApp de 30 minutes",
      "Programme d'un mois personnalisé via Nolio",
      "1 sortie accompagnée d'1h avec debrief complet",
      "Suivi WhatsApp illimité, réponse sous 24 à 48h",
    ],
  },
  {
    duration: "2 mois",
    title: "Montée en puissance",
    text: "Progresse avec un suivi qui s'adapte à toi et à tes résultats.",
    price: "269",
    // priceoffer: "215",
    includes: [
      "Permier entretien WhatsApp de 30 minutes",
      "Programme d'un mois personnalisé via Nolio",
      "Ajustement régulier du programme",
      "2 sorties accompagnées d'1h avec debrief ",
      "Suivi WhatsApp illimité, réponse sous 24 à 48h",
    ],
  },
  {
    duration: "3 mois",
    title: "Full engagement",
    text: "Vise un objectif précis et mets toutes les chances de ton côté sur la durée.",
    price: "339",
    // priceoffer: "269",
    includes: [
      "Permier entretien WhatsApp de 30 minutes",
      "Programme d'un mois personnalisé via Nolio",
      "Ajustement régulier du programme",
      "3 sorties accompagnées d'1h avec debrief",
      "Suivi WhatsApp illimité, réponse sous 24 à 48h",
    ],
  },
];
---

<div id="container">
  <main id="content" class="d-flex-column">
    <section
      aria-labelledby="tarifs-title"
      class="d-flex-column align-items-center gap2"
    >
      <h1 id="tarifs-title" class="text-color-peps">Programmes complets</h1>
      <span id="blocs" class="d-flex gap2">
        {
          tarifs.map((item, index) => (
            <article id="article" class="d-flex-column bloc">
              <p
                id="duration"
                class={`px1 border-radius-1 ${background[index]}`}
              >
                {item.duration}
              </p>
              <h2>{item.title}</h2>
              <p id="text">{item.text}</p>
              <section class="d-flex align-items-end gapx">
                <section class="d-flex-column">
                  <section class="d-flex gapx align-items-end">
                    <h3 class="price-original">{item.price}</h3>
                    {/* <h3 class="price-offer">{item.priceoffer}</h3> */}
                    <p>CHF</p>
                  </section>
                </section>
              </section>
              <hr class="separator" />
              <section>
                {item.includes.map((para) => (
                  <li>{para}</li>
                ))}
              </section>
            </article>
          ))
        }
      </span>
      <Book style="margin-top: auto;" />
    </section>
  </main>
</div>

<style>
  #content {
    padding: 3rem;
  }

  #article {
    width: 430px;
    gap: 1.5rem;
  }

  #duration {
    margin-bottom: 1rem;
    font-size: 14px;
    max-width: fit-content;
  }

  #text {
    height: 60px;
  }

  h2 {
    margin-top: -0.8rem;
  }

  .price-original {
    font-size: 36px;
    color: var(--peps);
    /* text-decoration: line-through; */
    /* text-decoration-color: var(--peps); */
    /* opacity: 0.5; */
    margin-top: 0;
  }

  /* .price-offer {
    font-size: 36px;
    color: var(--peps);
    margin-top: 0;
  } */

  li {
    margin: 0 2rem;
    list-style: circle;
  }

  /* =========================
     GRAND ECRAN
  ========================= */
  @media screen and (max-width: 1440px) {
    #content {
      padding: 3rem;
    }

    #article {
      width: 100%;
      max-width: 560px;
    }

    #text {
      height: auto;
    }
  }

  /* =========================
     TABLETTE
  ========================= */
  @media screen and (max-width: 1024px) {
    #content {
      padding: 3rem;
    }

    #blocs {
      flex-direction: column;
      align-items: center;
    }

    #article {
      width: 100%;
      max-width: 560px;
    }

    #text {
      height: auto;
    }
  }

  /* =========================
     MOBILE
  ========================= */
  @media screen and (max-width: 768px) {
    #content {
      padding: 2.5rem 2rem;
    }

    h1 {
      font-size: 32px;
    }

    #article {
      width: 100%;
      max-width: 100%;
      gap: 1.5rem;
    }
  }

  /* =========================
     PETITS SMARTPHONES
  ========================= */
  @media screen and (max-width: 480px) {
    #content {
      padding: 2rem 1.5rem;
    }

    h1 {
      font-size: 18px;
    }

    #article {
      gap: 1rem;
    }

    li {
      margin: 0 0.5rem;
    }
  }
</style>
