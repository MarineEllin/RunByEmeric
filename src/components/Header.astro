---
import logo from "../assets/logo.svg";
import "../styles/global.scss";

const currentPath = Astro.url.pathname;
const links = [
  { href: "/", label: "Accueil", aria: "Accueil" },
  { href: "/Apropos", label: "A propos", aria: "À propos d'Emeric Pujos" },
  {
    href: "/Tarifs",
    label: "Tarifs",
    aria: "Tarifs de l'accompagnement running",
  },
  {
    href: "/Contact",
    label: "Contact",
    aria: "Contact",
    outline: true,
  },
];
---

<header id="container">
  <nav
    class="bkg-light d-flex justify-content-center align-items-center"
    aria-label="Navigation principale"
  >
    <div id="logo" class="d-flex justify-content-center align-items-center">
      <a href="/" aria-label="RunByEmeric - Retour à l'accueil">
        <img
          src={logo.src}
          width="400"
          height="120"
          alt="RunByEmeric - Accompagnement running à Genève"
          loading="eager"
        />
      </a>
    </div>

    <div
      id="menu"
      class="d-flex justify-content-center align-items-center gap2"
      role="menubar"
    >
      {
        links.map((link) => (
          <a
            class={`btn ${link.outline && currentPath !== "/Contact" ? "btn--outline" : ""} ${currentPath === link.href ? "btn--active" : ""}`}
            href={link.href}
            aria-label={link.aria}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>

  <style>
    header {
      position: sticky;
      top: 0;
      z-index: 100;
    }

    nav {
      padding: 2rem;
      justify-content: space-evenly;
    }

    #logo {
      align-items: start;
    }

    /* =========================
     TABLETTE
  ========================= */
    @media screen and (max-width: 1024px) {
      nav {
        flex-direction: column;
        gap: 1.5rem;
        padding: 1.5rem;
      }

      #logo img {
        width: 260px;
        height: auto;
      }

      #menu {
        flex-wrap: wrap;
        justify-content: center;
      }
    }

    /* =========================
     MOBILE
  ========================= */
    @media screen and (max-width: 768px) {
      nav {
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
      }

      #logo {
        width: 100%;
        justify-content: center;
      }

      #logo img {
        width: 220px;
        height: auto;
      }

      #menu {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.75rem;
      }

      #menu a {
        width: 100%;
        text-align: center;
      }
    }

    /* =========================
     PETITS SMARTPHONES
  ========================= */
    @media screen and (max-width: 480px) {
      nav {
        padding: 0.75rem;
      }

      #logo img {
        width: 180px;
      }

      #menu {
        gap: 0.5rem;
      }

      #menu a {
        font-size: 0.95rem;
        padding: 0.75rem 1rem;
      }
    }
  </style>
</header>
