---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Message envoyé – RunByEmeric"
  description="Votre message a bien été envoyé."
>
  <div id="page">
    <Header />
    <div id="success">
      <p class="italic-eyebrow">Merci !</p>
      <h1 class="text-color-peps">Message bien reçu</h1>
      <p>Je vous réponds sous 24h. À très vite !</p>
      <a href="/" class="btn btn--outline">Retour à l'accueil</a>
    </div>
    <Footer />
  </div>
</Layout>

<style>
  #page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  #success {
    flex: 1;
    padding: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media screen and (max-width: 768px) {
    #success {
      padding: 2rem 1.5rem;
    }
  }
</style>
